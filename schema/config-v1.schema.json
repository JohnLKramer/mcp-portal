{
  "$defs": {
    "AuthConfig": {
      "additionalProperties": false,
      "properties": {
        "local_principal": {
          "$ref": "#/$defs/LocalPrincipalConfig",
          "description": "Locally-asserted principal settings."
        },
        "inbound": {
          "$ref": "#/$defs/InboundAuthConfig",
          "description": "Inbound JWT verification settings."
        }
      },
      "title": "AuthConfig",
      "type": "object"
    },
    "BodyEntry": {
      "additionalProperties": false,
      "properties": {
        "content_type": {
          "default": "application/json",
          "description": "Request body content type.",
          "title": "Content Type",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/BodyMode",
          "default": "flatten",
          "description": "Body construction mode."
        },
        "schema": {
          "additionalProperties": true,
          "description": "Request body JSON Schema.",
          "title": "Schema",
          "type": "object"
        }
      },
      "required": [
        "schema"
      ],
      "title": "BodyEntry",
      "type": "object"
    },
    "BodyMode": {
      "enum": [
        "flatten",
        "single_arg"
      ],
      "title": "BodyMode",
      "type": "string"
    },
    "ClassificationRule": {
      "additionalProperties": false,
      "properties": {
        "match": {
          "$ref": "#/$defs/MatchSpec",
          "description": "Match criteria."
        },
        "effect": {
          "anyOf": [
            {
              "$ref": "#/$defs/Effect"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Effect to assign to matching operations."
        },
        "sensitivity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sensitivity"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sensitivity to assign to matching operations."
        }
      },
      "required": [
        "match"
      ],
      "title": "ClassificationRule",
      "type": "object"
    },
    "Effect": {
      "description": "What an operation does to upstream state. Derived from the HTTP method.",
      "enum": [
        "read_only",
        "idempotent_write",
        "action"
      ],
      "title": "Effect",
      "type": "string"
    },
    "GraphQlBindingEntry": {
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "graphql",
          "default": "graphql",
          "title": "Protocol",
          "type": "string"
        },
        "operation_type": {
          "enum": [
            "query",
            "mutation"
          ],
          "title": "Operation Type",
          "type": "string"
        },
        "document": {
          "title": "Document",
          "type": "string"
        },
        "variables": {
          "items": {
            "$ref": "#/$defs/GraphQlVariableEntry"
          },
          "title": "Variables",
          "type": "array"
        }
      },
      "required": [
        "operation_type",
        "document"
      ],
      "title": "GraphQlBindingEntry",
      "type": "object"
    },
    "GraphQlIntrospectionConfig": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "pattern": "^https?://[^/?#\\s]+",
          "title": "Url",
          "type": "string"
        },
        "type_policy": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Type Policy",
          "type": "object"
        }
      },
      "required": [
        "url"
      ],
      "title": "GraphQlIntrospectionConfig",
      "type": "object"
    },
    "GraphQlVariableEntry": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "graphql_type": {
          "title": "Graphql Type",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "graphql_type"
      ],
      "title": "GraphQlVariableEntry",
      "type": "object"
    },
    "HttpBindingEntry": {
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "http",
          "default": "http",
          "description": "Upstream call protocol.",
          "title": "Protocol",
          "type": "string"
        },
        "method": {
          "description": "HTTP method.",
          "title": "Method",
          "type": "string"
        },
        "path": {
          "description": "Upstream path.",
          "title": "Path",
          "type": "string"
        },
        "parameters": {
          "description": "Bound parameters.",
          "items": {
            "$ref": "#/$defs/ParameterEntry"
          },
          "title": "Parameters",
          "type": "array"
        },
        "body": {
          "anyOf": [
            {
              "$ref": "#/$defs/BodyEntry"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bound request body."
        }
      },
      "required": [
        "method",
        "path"
      ],
      "title": "HttpBindingEntry",
      "type": "object"
    },
    "HttpServerConfig": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "default": "127.0.0.1",
          "description": "Bind address.",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 8443,
          "description": "Bind port.",
          "exclusiveMaximum": 65536,
          "exclusiveMinimum": 0,
          "title": "Port",
          "type": "integer"
        },
        "path": {
          "default": "/mcp",
          "description": "MCP endpoint path.",
          "title": "Path",
          "type": "string"
        },
        "allowed_origins": {
          "description": "Allowed Origin header values, for browser cross-origin checks.",
          "items": {
            "type": "string"
          },
          "title": "Allowed Origins",
          "type": "array"
        },
        "allowed_hosts": {
          "description": "Allowed Host header values. Needed behind a reverse proxy or when bound to 0.0.0.0, since no client sends that as its Host header.",
          "items": {
            "type": "string"
          },
          "title": "Allowed Hosts",
          "type": "array"
        },
        "session_idle_timeout_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Session idle timeout, in seconds.",
          "title": "Session Idle Timeout S"
        },
        "max_sessions": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum concurrent sessions.",
          "title": "Max Sessions"
        }
      },
      "title": "HttpServerConfig",
      "type": "object"
    },
    "InboundAuthConfig": {
      "additionalProperties": false,
      "description": "RFC 9068 access-token validation for `transport: http` (\u00a78).\n\n`algorithms` intentionally has no way to re-admit `alg: none` \u2014 the\nvalidator below rejects it even if a future operator adds it by hand.\nHMAC (`HS*`) is not excluded outright (RFC 9396 does not forbid it and\nan operator's IdP might legitimately use it), but v1 has no\nshared-secret config field, so JWKS-only key lookup makes an\nHS*-allowlisted deployment fail closed rather than succeed via\nkey-confusion.",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Inbound JWT verification flag.",
          "title": "Enabled",
          "type": "boolean"
        },
        "issuer": {
          "anyOf": [
            {
              "pattern": "^https?://[^/?#\\s]+",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Expected token issuer.",
          "title": "Issuer"
        },
        "audience": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Expected token audience.",
          "title": "Audience"
        },
        "jwks_uri": {
          "anyOf": [
            {
              "pattern": "^https?://[^/?#\\s]+",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JWKS endpoint. Discovered automatically from the issuer when omitted.",
          "title": "Jwks Uri"
        },
        "required_scopes": {
          "description": "Scopes every caller must have.",
          "items": {
            "type": "string"
          },
          "title": "Required Scopes",
          "type": "array"
        },
        "algorithms": {
          "description": "Accepted JWT signing algorithms.",
          "items": {
            "type": "string"
          },
          "title": "Algorithms",
          "type": "array"
        },
        "leeway_s": {
          "default": 60.0,
          "description": "Clock-skew allowance, in seconds.",
          "minimum": 0,
          "title": "Leeway S",
          "type": "number"
        },
        "allow_unauthenticated_http": {
          "default": false,
          "description": "Unauthenticated HTTP escape hatch, for non-loopback hosts with no inbound auth.",
          "title": "Allow Unauthenticated Http",
          "type": "boolean"
        }
      },
      "title": "InboundAuthConfig",
      "type": "object"
    },
    "IntrospectionConfig": {
      "additionalProperties": false,
      "properties": {
        "openapi": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpenApiIntrospectionConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "OpenAPI introspection settings."
        },
        "graphql": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphQlIntrospectionConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "GraphQL introspection settings."
        }
      },
      "title": "IntrospectionConfig",
      "type": "object"
    },
    "LocalPrincipalConfig": {
      "additionalProperties": false,
      "description": "Raw `authorization_details`, parsed into domain objects by\n`auth.principal.local_principal`. Kept as `list[dict]` here rather than\n`config.policy.RequireConfig`'s strict model: a *presented* detail may\ncarry RFC 9396 type-specific extension fields the way a *required* one\nmust not (\u00a75) \u2014 strict rejection is reserved for `require`.",
      "properties": {
        "authorization_details": {
          "description": "Locally-asserted authorization details: the caller's identity outside the HTTP transport, or HTTP's fallback when inbound auth is disabled.",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Authorization Details",
          "type": "array"
        }
      },
      "title": "LocalPrincipalConfig",
      "type": "object"
    },
    "MatchSpec": {
      "additionalProperties": false,
      "properties": {
        "ids": {
          "description": "Operation IDs to match.",
          "items": {
            "type": "string"
          },
          "title": "Ids",
          "type": "array"
        },
        "tags": {
          "description": "Group tags to match.",
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "upstream": {
          "description": "Upstream names to match.",
          "items": {
            "type": "string"
          },
          "title": "Upstream",
          "type": "array"
        },
        "effect": {
          "description": "Effects to match.",
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "title": "Effect",
          "type": "array"
        }
      },
      "title": "MatchSpec",
      "type": "object"
    },
    "NamingConfig": {
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "default": "operation_id",
          "description": "Tool name generation strategy.",
          "enum": [
            "operation_id",
            "method_path"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "prefix_with_group_tag": {
          "default": false,
          "description": "Group-tag prefix flag.",
          "title": "Prefix With Group Tag",
          "type": "boolean"
        },
        "prefix_with_upstream": {
          "default": false,
          "description": "Upstream-name prefix flag.",
          "title": "Prefix With Upstream",
          "type": "boolean"
        }
      },
      "title": "NamingConfig",
      "type": "object"
    },
    "OpenApiIntrospectionConfig": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "anyOf": [
            {
              "pattern": "^https?://[^/?#\\s]+",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "OpenAPI document URL, for fetching over HTTP.",
          "title": "Url"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "OpenAPI document path, for loading from disk.",
          "title": "File"
        },
        "include_deprecated": {
          "default": false,
          "description": "Deprecated-operation inclusion flag.",
          "title": "Include Deprecated",
          "type": "boolean"
        },
        "allow_external_refs": {
          "default": false,
          "description": "External $ref following flag.",
          "title": "Allow External Refs",
          "type": "boolean"
        },
        "allowed_hosts": {
          "description": "External $ref host allowlist.",
          "items": {
            "type": "string"
          },
          "title": "Allowed Hosts",
          "type": "array"
        }
      },
      "title": "OpenApiIntrospectionConfig",
      "type": "object"
    },
    "OperationEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Operation ID. The stable identifier for matching; never the tool name.",
          "title": "Id",
          "type": "string"
        },
        "upstream": {
          "description": "Owning upstream name.",
          "title": "Upstream",
          "type": "string"
        },
        "description": {
          "description": "Tool description, shown to the model.",
          "title": "Description",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tool title, shown to the model.",
          "title": "Title"
        },
        "name": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9_]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Explicit tool name override.",
          "title": "Name"
        },
        "group_tags": {
          "description": "Grouping tags.",
          "items": {
            "type": "string"
          },
          "title": "Group Tags",
          "type": "array"
        },
        "effect": {
          "anyOf": [
            {
              "$ref": "#/$defs/Effect"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Operation effect override."
        },
        "sensitivity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sensitivity"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Operation sensitivity override."
        },
        "binding": {
          "description": "Upstream call binding.",
          "oneOf": [
            {
              "$ref": "#/$defs/HttpBindingEntry"
            },
            {
              "$ref": "#/$defs/GraphQlBindingEntry"
            }
          ],
          "title": "Binding"
        }
      },
      "required": [
        "id",
        "upstream",
        "description",
        "binding"
      ],
      "title": "OperationEntry",
      "type": "object"
    },
    "OutboundConfig": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "none",
          "description": "Outbound credential strategy.",
          "enum": [
            "none",
            "static",
            "client_credentials",
            "token_exchange"
          ],
          "title": "Mode",
          "type": "string"
        },
        "header": {
          "default": "Authorization",
          "description": "Credential header name.",
          "title": "Header",
          "type": "string"
        },
        "scheme": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "Bearer",
          "description": "Credential header scheme prefix.",
          "title": "Scheme"
        },
        "value": {
          "anyOf": [
            {
              "pattern": "^\\$\\{(env|file):[^}]+\\}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Static credential value, for mode 'static'.",
          "title": "Value"
        },
        "token_endpoint": {
          "anyOf": [
            {
              "pattern": "^https?://[^/?#\\s]+",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "OAuth token endpoint, for mode 'client_credentials' or 'token_exchange'.",
          "title": "Token Endpoint"
        },
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "OAuth client ID.",
          "title": "Client Id"
        },
        "client_secret": {
          "anyOf": [
            {
              "pattern": "^\\$\\{(env|file):[^}]+\\}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "OAuth client secret.",
          "title": "Client Secret"
        },
        "scopes": {
          "description": "Requested OAuth scopes.",
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        },
        "audience": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Requested token audience.",
          "title": "Audience"
        },
        "resource": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Requested token resource indicator.",
          "title": "Resource"
        },
        "requested_token_type": {
          "default": "urn:ietf:params:oauth:token-type:access_token",
          "description": "Requested token type, for token exchange.",
          "title": "Requested Token Type",
          "type": "string"
        }
      },
      "title": "OutboundConfig",
      "type": "object"
    },
    "ParamLocation": {
      "enum": [
        "path",
        "query",
        "header"
      ],
      "title": "ParamLocation",
      "type": "string"
    },
    "ParameterEntry": {
      "additionalProperties": false,
      "properties": {
        "arg": {
          "description": "Tool argument name.",
          "title": "Arg",
          "type": "string"
        },
        "in": {
          "$ref": "#/$defs/ParamLocation",
          "description": "Parameter location: query, path, or header."
        },
        "wire_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Wire parameter name, if different from the argument name.",
          "title": "Wire Name"
        },
        "required": {
          "default": false,
          "description": "Required-parameter flag.",
          "title": "Required",
          "type": "boolean"
        },
        "schema": {
          "additionalProperties": true,
          "description": "Argument JSON Schema.",
          "title": "Schema",
          "type": "object"
        },
        "style": {
          "const": "form",
          "default": "form",
          "description": "Parameter serialization style.",
          "title": "Style",
          "type": "string"
        },
        "explode": {
          "default": true,
          "description": "Array/object explode flag.",
          "title": "Explode",
          "type": "boolean"
        }
      },
      "required": [
        "arg",
        "in"
      ],
      "title": "ParameterEntry",
      "type": "object"
    },
    "PolicyFileConfig": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "description": "Policy file path.",
          "title": "File",
          "type": "string"
        }
      },
      "required": [
        "file"
      ],
      "title": "PolicyFileConfig",
      "type": "object"
    },
    "SelectionConfig": {
      "additionalProperties": false,
      "properties": {
        "include_tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tags to expose. Omit to expose every tag.",
          "title": "Include Tags"
        },
        "exclude_tags": {
          "description": "Tags to hide.",
          "items": {
            "type": "string"
          },
          "title": "Exclude Tags",
          "type": "array"
        },
        "include_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Operation IDs to expose. Omit to expose every operation.",
          "title": "Include Ids"
        },
        "exclude_ids": {
          "description": "Operation IDs to hide.",
          "items": {
            "type": "string"
          },
          "title": "Exclude Ids",
          "type": "array"
        }
      },
      "title": "SelectionConfig",
      "type": "object"
    },
    "Sensitivity": {
      "description": "Whether an operation's data is safe to expose. Never derived.",
      "enum": [
        "normal",
        "sensitive"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "ServerConfig": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Server name, reported to MCP clients.",
          "title": "Name",
          "type": "string"
        },
        "transport": {
          "default": "stdio",
          "description": "Transport protocol.",
          "enum": [
            "stdio",
            "http"
          ],
          "title": "Transport",
          "type": "string"
        },
        "http": {
          "$ref": "#/$defs/HttpServerConfig",
          "description": "HTTP transport settings, used when transport is 'http'."
        }
      },
      "required": [
        "name"
      ],
      "title": "ServerConfig",
      "type": "object"
    },
    "UpstreamAuthConfig": {
      "additionalProperties": false,
      "properties": {
        "outbound": {
          "$ref": "#/$defs/OutboundConfig",
          "description": "Outbound credential settings."
        }
      },
      "title": "UpstreamAuthConfig",
      "type": "object"
    },
    "UpstreamConfig": {
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "http",
          "default": "http",
          "description": "Upstream protocol.",
          "title": "Protocol",
          "type": "string"
        },
        "base_url": {
          "anyOf": [
            {
              "pattern": "^https?://[^/?#\\s]+",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Upstream base URL.",
          "title": "Base Url"
        },
        "timeout_ms": {
          "default": 30000,
          "description": "Per-call timeout, in milliseconds.",
