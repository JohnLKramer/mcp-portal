{
  "$defs": {
    "AuthConfig": {
      "additionalProperties": false,
      "properties": {
        "local_principal": {
          "$ref": "#/$defs/LocalPrincipalConfig"
        },
        "inbound": {
          "$ref": "#/$defs/InboundAuthConfig"
        }
      },
      "title": "AuthConfig",
      "type": "object"
    },
    "BindingEntry": {
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "http",
          "default": "http",
          "title": "Protocol",
          "type": "string"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/ParameterEntry"
          },
          "title": "Parameters",
          "type": "array"
        },
        "body": {
          "anyOf": [
            {
              "$ref": "#/$defs/BodyEntry"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "method",
        "path"
      ],
      "title": "BindingEntry",
      "type": "object"
    },
    "BodyEntry": {
      "additionalProperties": false,
      "properties": {
        "content_type": {
          "default": "application/json",
          "title": "Content Type",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/BodyMode",
          "default": "flatten"
        },
        "schema": {
          "additionalProperties": true,
          "title": "Schema",
          "type": "object"
        }
      },
      "required": [
        "schema"
      ],
      "title": "BodyEntry",
      "type": "object"
    },
    "BodyMode": {
      "enum": [
        "flatten",
        "single_arg"
      ],
      "title": "BodyMode",
      "type": "string"
    },
    "ClassificationRule": {
      "additionalProperties": false,
      "properties": {
        "match": {
          "$ref": "#/$defs/MatchSpec"
        },
        "effect": {
          "anyOf": [
            {
              "$ref": "#/$defs/Effect"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sensitivity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sensitivity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "match"
      ],
      "title": "ClassificationRule",
      "type": "object"
    },
    "Effect": {
      "description": "What an operation does to upstream state. Derived from the HTTP method.",
      "enum": [
        "read_only",
        "idempotent_write",
        "action"
      ],
      "title": "Effect",
      "type": "string"
    },
    "HttpServerConfig": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "default": "127.0.0.1",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 8443,
          "exclusiveMaximum": 65536,
          "exclusiveMinimum": 0,
          "title": "Port",
          "type": "integer"
        },
        "path": {
          "default": "/mcp",
          "title": "Path",
          "type": "string"
        },
        "allowed_origins": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Origins",
          "type": "array"
        }
      },
      "title": "HttpServerConfig",
      "type": "object"
    },
    "InboundAuthConfig": {
      "additionalProperties": false,
      "description": "RFC 9068 access-token validation for `transport: http` (\u00a78).\n\n`algorithms` intentionally has no way to re-admit `alg: none` \u2014 the\nvalidator below rejects it even if a future operator adds it by hand.\nHMAC (`HS*`) is not excluded outright (RFC 9396 does not forbid it and\nan operator's IdP might legitimately use it), but v1 has no\nshared-secret config field, so JWKS-only key lookup makes an\nHS*-allowlisted deployment fail closed rather than succeed via\nkey-confusion.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "issuer": {
          "anyOf": [
            {
              "pattern": "^https?://[^/?#\\s]+",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issuer"
        },
        "audience": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audience"
        },
        "jwks_uri": {
          "anyOf": [
            {
              "pattern": "^https?://[^/?#\\s]+",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jwks Uri"
        },
        "required_scopes": {
          "items": {
            "type": "string"
          },
          "title": "Required Scopes",
          "type": "array"
        },
        "algorithms": {
          "items": {
            "type": "string"
          },
          "title": "Algorithms",
          "type": "array"
        },
        "leeway_s": {
          "default": 60.0,
          "minimum": 0,
          "title": "Leeway S",
          "type": "number"
        },
        "allow_unauthenticated_http": {
          "default": false,
          "title": "Allow Unauthenticated Http",
          "type": "boolean"
        }
      },
      "title": "InboundAuthConfig",
      "type": "object"
    },
    "IntrospectionConfig": {
      "additionalProperties": false,
      "properties": {
        "openapi": {
          "$ref": "#/$defs/OpenApiIntrospectionConfig"
        }
      },
      "required": [
        "openapi"
      ],
      "title": "IntrospectionConfig",
      "type": "object"
    },
    "LocalPrincipalConfig": {
      "additionalProperties": false,
      "description": "Raw `authorization_details`, parsed into domain objects by\n`auth.principal.local_principal`. Kept as `list[dict]` here rather than\n`config.policy.RequireConfig`'s strict model: a *presented* detail may\ncarry RFC 9396 type-specific extension fields the way a *required* one\nmust not (\u00a75) \u2014 strict rejection is reserved for `require`.",
      "properties": {
        "authorization_details": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Authorization Details",
          "type": "array"
        }
      },
      "title": "LocalPrincipalConfig",
      "type": "object"
    },
    "MatchSpec": {
      "additionalProperties": false,
      "properties": {
        "ids": {
          "items": {
            "type": "string"
          },
          "title": "Ids",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "upstream": {
          "items": {
            "type": "string"
          },
          "title": "Upstream",
          "type": "array"
        },
        "effect": {
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "title": "Effect",
          "type": "array"
        }
      },
      "title": "MatchSpec",
      "type": "object"
    },
    "NamingConfig": {
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "default": "operation_id",
          "enum": [
            "operation_id",
            "method_path"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "prefix_with_group_tag": {
          "default": false,
          "title": "Prefix With Group Tag",
          "type": "boolean"
        },
        "prefix_with_upstream": {
          "default": false,
          "title": "Prefix With Upstream",
          "type": "boolean"
        }
      },
      "title": "NamingConfig",
      "type": "object"
    },
    "OpenApiIntrospectionConfig": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "anyOf": [
            {
              "pattern": "^https?://[^/?#\\s]+",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "include_deprecated": {
          "default": false,
          "title": "Include Deprecated",
          "type": "boolean"
        },
        "allow_external_refs": {
          "default": false,
          "title": "Allow External Refs",
          "type": "boolean"
        },
        "allowed_hosts": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Hosts",
          "type": "array"
        }
      },
      "title": "OpenApiIntrospectionConfig",
      "type": "object"
    },
    "OperationEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "upstream": {
          "title": "Upstream",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "name": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9_]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "group_tags": {
          "items": {
            "type": "string"
          },
          "title": "Group Tags",
          "type": "array"
        },
        "effect": {
          "anyOf": [
            {
              "$ref": "#/$defs/Effect"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sensitivity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sensitivity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "binding": {
          "$ref": "#/$defs/BindingEntry"
        }
      },
      "required": [
        "id",
        "upstream",
        "description",
        "binding"
      ],
      "title": "OperationEntry",
      "type": "object"
    },
    "OutboundConfig": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "none",
          "enum": [
            "none",
            "static",
            "client_credentials",
            "token_exchange"
          ],
          "title": "Mode",
          "type": "string"
        },
        "header": {
          "default": "Authorization",
          "title": "Header",
          "type": "string"
        },
        "scheme": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "Bearer",
          "title": "Scheme"
        },
        "value": {
          "anyOf": [
            {
              "pattern": "^\\$\\{(env|file):[^}]+\\}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "token_endpoint": {
          "anyOf": [
            {
              "pattern": "^https?://[^/?#\\s]+",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Endpoint"
        },
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id"
        },
        "client_secret": {
          "anyOf": [
            {
              "pattern": "^\\$\\{(env|file):[^}]+\\}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Secret"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        },
        "audience": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audience"
        },
        "resource": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource"
        },
        "requested_token_type": {
          "default": "urn:ietf:params:oauth:token-type:access_token",
          "title": "Requested Token Type",
          "type": "string"
        }
      },
      "title": "OutboundConfig",
      "type": "object"
    },
    "ParamLocation": {
      "enum": [
        "path",
        "query",
        "header"
      ],
      "title": "ParamLocation",
      "type": "string"
    },
    "ParameterEntry": {
      "additionalProperties": false,
      "properties": {
        "arg": {
          "title": "Arg",
          "type": "string"
        },
        "in": {
          "$ref": "#/$defs/ParamLocation"
        },
        "wire_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wire Name"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "schema": {
          "additionalProperties": true,
          "title": "Schema",
          "type": "object"
        },
        "style": {
          "const": "form",
          "default": "form",
          "title": "Style",
          "type": "string"
        },
        "explode": {
          "default": true,
          "title": "Explode",
          "type": "boolean"
        }
      },
      "required": [
        "arg",
        "in"
      ],
      "title": "ParameterEntry",
      "type": "object"
    },
    "PolicyFileConfig": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        }
      },
      "required": [
        "file"
      ],
      "title": "PolicyFileConfig",
      "type": "object"
    },
    "SelectionConfig": {
      "additionalProperties": false,
      "properties": {
        "include_tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Include Tags"
        },
        "exclude_tags": {
          "items": {
            "type": "string"
          },
          "title": "Exclude Tags",
          "type": "array"
        },
        "include_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Include Ids"
        },
        "exclude_ids": {
          "items": {
            "type": "string"
          },
          "title": "Exclude Ids",
          "type": "array"
        }
      },
      "title": "SelectionConfig",
      "type": "object"
    },
    "Sensitivity": {
      "description": "Whether an operation's data is safe to expose. Never derived.",
      "enum": [
        "normal",
        "sensitive"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "ServerConfig": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "transport": {
          "default": "stdio",
          "enum": [
            "stdio",
            "http"
          ],
          "title": "Transport",
          "type": "string"
        },
        "http": {
          "$ref": "#/$defs/HttpServerConfig"
        }
      },
      "required": [
        "name"
      ],
      "title": "ServerConfig",
      "type": "object"
    },
    "UpstreamAuthConfig": {
      "additionalProperties": false,
      "properties": {
        "outbound": {
          "$ref": "#/$defs/OutboundConfig"
        }
      },
      "title": "UpstreamAuthConfig",
      "type": "object"
    },
    "UpstreamConfig": {
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "http",
          "default": "http",
          "title": "Protocol",
          "type": "string"
        },
        "base_url": {
          "anyOf": [
            {
              "pattern": "^https?://[^/?#\\s]+",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url"
        },
        "timeout_ms": {
          "default": 30000,
          "exclusiveMinimum": 0,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "max_total_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Total Ms"
        },
        "max_response_bytes": {
          "default": 1048576,
          "exclusiveMinimum": 0,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "auth": {
          "$ref": "#/$defs/UpstreamAuthConfig"
        },
        "introspection": {
          "anyOf": [
            {
              "$ref": "#/$defs/IntrospectionConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "UpstreamConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1",
      "title": "Version",
      "type": "string"
    },
    "mode": {
      "enum": [
        "configured",
        "introspect-safe",
        "introspect-unsafe"
      ],
      "title": "Mode",
      "type": "string"
    },
    "acknowledge_unsafe": {
      "default": false,
      "title": "Acknowledge Unsafe",
      "type": "boolean"
    },
    "server": {
      "$ref": "#/$defs/ServerConfig"
    },
    "upstreams": {
      "additionalProperties": {
        "$ref": "#/$defs/UpstreamConfig"
      },
      "title": "Upstreams",
      "type": "object"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/OperationEntry"
      },
      "title": "Operations",
      "type": "array"
    },
    "classification": {
      "items": {
        "$ref": "#/$defs/ClassificationRule"
      },
      "title": "Classification",
      "type": "array"
    },
    "selection": {
      "$ref": "#/$defs/SelectionConfig"
    },
    "naming": {
      "$ref": "#/$defs/NamingConfig"
    },
    "auth": {
      "$ref": "#/$defs/AuthConfig"
    },
    "policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/PolicyFileConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "version",
    "mode",
    "server",
    "upstreams"
  ],
  "title": "mcp-portal configuration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mcp-portal.dev/config-v1.schema.json"
}
